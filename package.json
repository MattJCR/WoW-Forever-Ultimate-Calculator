{
  "name": "wow-forever-ultimate-calculator",
  "private": true,
  "version": "0.0.0",
  "description": "Calculadora/simulador de WoW Forever (talentos, raza, estadisticas, habilidades, dano y curacion)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "pipeline": "npm run build-data -w @wfuc/data-pipeline",
    "contrast": "npm run contrast -w @wfuc/data-pipeline",
    "test": "npm run test --workspaces --if-present && npm run test:tools",
    "test:tools": "node --test tools/model/test/model.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright-core": "1.57.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.7.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
